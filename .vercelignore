# Deploy only what the game loads at runtime: index.html, sprites/, assets/, fonts/,
# and the title-screen plates in images/.

.venv/
__pycache__/
.DS_Store
.claude/

# Sprite-sheet sources — tools/extract_sprites.py turns these into sprites/.
Characters.png
Jump.png
Ready.png
Stand.png
images/karakter-*

# images/ is no longer sources-only: the title screen fetches images/bg.jpg and
# images/title.webp from here, and images/title.png has to ship too because it is
# the <picture> fallback for browsers without WebP. Only bg.png is excluded — it is
# the source plate for bg.jpg and nothing requests it at runtime. Ignoring the whole
# directory, as this file used to, ships a title screen with no background or logo.
images/bg.png

# Audio: the page loads audio/*.m4a plus audio/sfx.json (the sprite-sheet offset map).
# The WAVs are the synthesis intermediates and preview.html is the audition page —
# 3.2 MB between them, and nothing at runtime asks for either.
audio/wav/
audio/preview.html

# Build-time only.
tools/
README.md
SOUND.md
